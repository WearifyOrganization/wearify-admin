# Names only. Never commit real values.

# Convex deployment this app talks to (the one wearify-backend deploys).
# Inlined at build time; required for `next build`.
NEXT_PUBLIC_CONVEX_URL=
# The deployment's HTTP-actions host (…convex.site). Better Auth runs inside
# Convex; lib/auth-server.ts forwards /api/auth/* there and mints the SSR token.
NEXT_PUBLIC_CONVEX_SITE_URL=

# Sentry (all optional; without a DSN the SDK is inert).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENV=
NEXT_PUBLIC_SENTRY_ENV=
NEXT_PUBLIC_SENTRY_TRACES_RATE=
# Build-time only, for source-map upload in CI.
SENTRY_AUTH_TOKEN=

# Better Auth's own secret and SITE_URL are set on the Convex deployment
# (wearify-backend), never in this app.
